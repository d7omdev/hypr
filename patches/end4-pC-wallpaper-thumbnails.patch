diff --git a/modules/ii/wallpaperSelector/LocalWallpaperGrid.qml b/modules/ii/wallpaperSelector/LocalWallpaperGrid.qml
index ff201ab..6e1745d 100644
--- a/modules/ii/wallpaperSelector/LocalWallpaperGrid.qml
+++ b/modules/ii/wallpaperSelector/LocalWallpaperGrid.qml
@@ -24,6 +24,30 @@ Item {
     property int columns: Config.options.wallpaperSelector.columns || 4
     property real previewCellAspectRatio: 4 / 3
 
+    // Thumbnails are looked up by size bucket, so a bucket that was never generated
+    // leaves every tile blank. Regenerate whenever the folder or the cell size changes.
+    readonly property real thumbnailItemInset: (Appearance.sizes.wallpaperSelectorItemMargins + Appearance.sizes.wallpaperSelectorItemPadding) * 2
+    readonly property string thumbnailSizeName: (grid.cellWidth > thumbnailItemInset && grid.cellHeight > thumbnailItemInset)
+        ? Images.thumbnailSizeNameForDimensions(grid.cellWidth - thumbnailItemInset, grid.cellHeight - thumbnailItemInset)
+        : ""
+
+    Timer {
+        id: thumbnailUpdateTimer
+        interval: 200
+        onTriggered: {
+            if (root.thumbnailSizeName.length === 0) return;
+            Wallpapers.generateThumbnail(root.thumbnailSizeName);
+        }
+    }
+
+    onThumbnailSizeNameChanged: thumbnailUpdateTimer.restart()
+    Component.onCompleted: thumbnailUpdateTimer.restart()
+
+    Connections {
+        target: Wallpapers
+        function onDirectoryChanged() { thumbnailUpdateTimer.restart() }
+    }
+
     Process {
         id: deleteProc
         property string filePath: ""
