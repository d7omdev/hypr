+def build_var_map(raw: str) -> Dict[str, str]:
+    """Collect `local NAME = "VALUE"` string constants for key resolution."""
+    m: Dict[str, str] = {}
+    for name, val in re.findall(r'^\s*local\s+([A-Za-z_]\w*)\s*=\s*"([^"]*)"', raw, re.MULTILINE):
+        m[name] = val
+    return m
