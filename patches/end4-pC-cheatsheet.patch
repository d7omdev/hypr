diff --git a/modules/ii/cheatsheet/Cheatsheet.qml b/modules/ii/cheatsheet/Cheatsheet.qml
new file mode 100644
index 0000000..79b2380
--- /dev/null
+++ b/modules/ii/cheatsheet/Cheatsheet.qml
@@ -0,0 +1,223 @@
+import qs.services
+import qs.modules.common
+import qs.modules.common.widgets
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+import Qt.labs.synchronizer
+import Qt5Compat.GraphicalEffects
+import Quickshell.Io
+import Quickshell
+import Quickshell.Wayland
+import Quickshell.Hyprland
+
+Scope { // Scope
+    id: root
+    property var tabButtonList: [
+        {
+            "icon": "keyboard",
+            "name": Translation.tr("Keybinds")
+        },
+        {
+            "icon": "experiment",
+            "name": Translation.tr("Elements")
+        },
+    ]
+
+    Loader {
+        id: cheatsheetLoader
+        active: false
+
+        sourceComponent: PanelWindow { // Window
+            id: cheatsheetRoot
+            visible: cheatsheetLoader.active
+
+            anchors {
+                top: true
+                bottom: true
+                left: true
+                right: true
+            }
+
+            function hide() {
+                cheatsheetLoader.active = false;
+            }
+            exclusiveZone: 0
+            implicitWidth: cheatsheetBackground.width + Appearance.sizes.elevationMargin * 2
+            implicitHeight: cheatsheetBackground.height + Appearance.sizes.elevationMargin * 2
+            WlrLayershell.namespace: "quickshell:cheatsheet"
+            // Setting this value makes it take its sweet time to open
+            // WlrLayershell.keyboardFocus: WlrKeyboardFocus.OnDemand
+            color: "transparent"
+
+            mask: Region {
+                item: cheatsheetBackground
+            }
+
+            Component.onCompleted: {
+                GlobalFocusGrab.addDismissable(cheatsheetRoot);
+            }
+            Component.onDestruction: {
+                GlobalFocusGrab.removeDismissable(cheatsheetRoot);
+            }
+            Connections {
+                target: GlobalFocusGrab
+                function onDismissed() {
+                    cheatsheetRoot.hide();
+                }
+            }
+
+            // Background
+            StyledRectangularShadow {
+                target: cheatsheetBackground
+            }
+            Rectangle {
+                id: cheatsheetBackground
+                anchors.centerIn: parent
+                color: Appearance.colors.colLayer0
+                border.width: 1
+                border.color: Appearance.colors.colLayer0Border
+                radius: Appearance.rounding.windowRounding
+                property real padding: 20
+                implicitWidth: cheatsheetColumnLayout.implicitWidth + padding * 2
+                implicitHeight: cheatsheetColumnLayout.implicitHeight + padding * 2
+
+                Keys.onPressed: event => { // Esc to close
+                    if (event.key === Qt.Key_Escape) {
+                        cheatsheetRoot.hide();
+                    }
+                    if (event.modifiers === Qt.ControlModifier) {
+                        if (event.key === Qt.Key_PageDown) {
+                            tabBar.incrementCurrentIndex();
+                            event.accepted = true;
+                        } else if (event.key === Qt.Key_PageUp) {
+                            tabBar.decrementCurrentIndex();
+                            event.accepted = true;
+                        } else if (event.key === Qt.Key_Tab) {
+                            tabBar.setCurrentIndex((tabBar.currentIndex + 1) % root.tabButtonList.length);
+                            event.accepted = true;
+                        } else if (event.key === Qt.Key_Backtab) {
+                            tabBar.setCurrentIndex((tabBar.currentIndex - 1 + root.tabButtonList.length) % root.tabButtonList.length);
+                            event.accepted = true;
+                        }
+                    }
+                }
+
+                RippleButton { // Close button
+                    id: closeButton
+                    focus: cheatsheetRoot.visible
+                    implicitWidth: 40
+                    implicitHeight: 40
+                    buttonRadius: Appearance.rounding.full
+                    anchors {
+                        top: parent.top
+                        right: parent.right
+                        topMargin: 20
+                        rightMargin: 20
+                    }
+
+                    onClicked: {
+                        cheatsheetRoot.hide();
+                    }
+
+                    contentItem: MaterialSymbol {
+                        anchors.centerIn: parent
+                        horizontalAlignment: Text.AlignHCenter
+                        font.pixelSize: Appearance.font.pixelSize.title
+                        text: "close"
+                    }
+                }
+
+                ColumnLayout { // Real content
+                    id: cheatsheetColumnLayout
+                    anchors.centerIn: parent
+                    spacing: 10
+
+                    Toolbar {
+                        Layout.alignment: Qt.AlignHCenter
+                        enableShadow: false
+                        ToolbarTabBar {
+                            id: tabBar
+                            tabButtonList: root.tabButtonList
+
+                            Synchronizer on currentIndex {
+                                property alias source: swipeView.currentIndex
+                            }
+                        }
+                    }
+
+                    SwipeView { // Content pages
+                        id: swipeView
+                        Layout.topMargin: 5
+                        Layout.fillWidth: true
+                        Layout.fillHeight: true
+                        spacing: 10
+                        currentIndex: Persistent.states.cheatsheet.tabIndex
+                        onCurrentIndexChanged: {
+                            Persistent.states.cheatsheet.tabIndex = currentIndex;
+                        }
+
+                        implicitWidth: Math.max.apply(null, contentChildren.map(child => child.implicitWidth || 0))
+                        implicitHeight: Math.max.apply(null, contentChildren.map(child => child.implicitHeight || 0))
+
+                        clip: true
+                        layer.enabled: true
+                        layer.effect: OpacityMask {
+                            maskSource: Rectangle {
+                                width: swipeView.width
+                                height: swipeView.height
+                                radius: Appearance.rounding.small
+                            }
+                        }
+
+                        CheatsheetKeybinds {}
+                        CheatsheetPeriodicTable {}
+                    }
+                }
+            }
+        }
+    }
+
+    IpcHandler {
+        target: "cheatsheet"
+
+        function toggle(): void {
+            cheatsheetLoader.active = !cheatsheetLoader.active;
+        }
+
+        function close(): void {
+            cheatsheetLoader.active = false;
+        }
+
+        function open(): void {
+            cheatsheetLoader.active = true;
+        }
+    }
+
+    GlobalShortcut {
+        name: "cheatsheetToggle"
+        description: "Toggles cheatsheet on press"
+
+        onPressed: {
+            cheatsheetLoader.active = !cheatsheetLoader.active;
+        }
+    }
+
+    GlobalShortcut {
+        name: "cheatsheetOpen"
+        description: "Opens cheatsheet on press"
+
+        onPressed: {
+            cheatsheetLoader.active = true;
+        }
+    }
+
+    GlobalShortcut {
+        name: "cheatsheetClose"
+        description: "Closes cheatsheet on press"
+
+        onPressed: {
+            cheatsheetLoader.active = false;
+        }
+    }
+}
diff --git a/modules/ii/cheatsheet/CheatsheetKeybinds.qml b/modules/ii/cheatsheet/CheatsheetKeybinds.qml
new file mode 100644
index 0000000..577428c
--- /dev/null
+++ b/modules/ii/cheatsheet/CheatsheetKeybinds.qml
@@ -0,0 +1,80 @@
+pragma ComponentBehavior: Bound
+
+import qs.services
+import qs.modules.common
+import qs.modules.common.widgets
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+
+// Adapted for end4-pC's HyprlandKeybinds service, which exposes a *tree*
+// ({ name, keybinds, children }) parsed from hyprland/keybinds.lua by
+// get_keybinds.py. The tree only promotes SOME binds into named nodes and
+// leaves the rest in the root, so we ignore the tree grouping entirely:
+// flatten every bind, then group by the "Category: description" prefix in each
+// bind's .comment (matching the upstream behavior, which grouped by .description).
+Item {
+    id: root
+    property real padding: 4
+    implicitWidth: QsWindow?.window?.screen.width * 0.7 ?? 0
+    implicitHeight: QsWindow?.window?.screen.height * 0.7 ?? 0
+
+    // Every keybind, flattened from the whole tree.
+    readonly property var allBinds: {
+        const out = [];
+        const walk = node => {
+            for (const b of (node?.keybinds ?? []))
+                out.push(b);
+            for (const c of (node?.children ?? []))
+                walk(c);
+        };
+        walk(HyprlandKeybinds.keybinds);
+        return out;
+    }
+
+    // Distinct category names (text before the first ":") in first-seen order,
+    // with "" appended last to collect uncategorized binds.
+    readonly property var categories: {
+        const seen = [];
+        for (const b of root.allBinds) {
+            const c = b.comment ?? "";
+            const idx = c.indexOf(":");
+            if (idx <= 0)
+                continue;
+            const cat = c.substring(0, idx).trim();
+            if (cat.length > 0 && !seen.includes(cat))
+                seen.push(cat);
+        }
+        seen.push(""); // uncategorized bucket
+        return seen;
+    }
+
+    StyledFlickable {
+        id: flickable
+        clip: true
+        anchors.fill: parent
+        anchors.margins: Appearance.rounding.small
+        contentHeight: height
+        contentWidth: flow.implicitWidth
+        Flow {
+            id: flow
+            height: flickable.height
+            flow: Flow.TopToBottom
+            spacing: 10
+            Repeater {
+                model: root.categories
+                delegate: CheatsheetKeybindsCategory {
+                    required property var modelData
+                    categoryName: modelData
+                    allBinds: root.allBinds
+                }
+            }
+        }
+    }
+
+    ScrollEdgeFade {
+        target: flickable
+        vertical: false
+        color: Appearance.colors.colLayer0Base
+    }
+}
diff --git a/modules/ii/cheatsheet/CheatsheetKeybindsCategory.qml b/modules/ii/cheatsheet/CheatsheetKeybindsCategory.qml
new file mode 100644
index 0000000..9998dc5
--- /dev/null
+++ b/modules/ii/cheatsheet/CheatsheetKeybindsCategory.qml
@@ -0,0 +1,144 @@
+pragma ComponentBehavior: Bound
+
+import qs.modules.common
+import qs.modules.common.widgets
+import QtQuick
+import QtQuick.Layouts
+
+// Renders one keybind category by filtering the flat bind list on the
+// "Category: description" prefix in each bind's .comment. Binds come from
+// end4-pC's HyprlandKeybinds tree: { mods: [str], key, comment }.
+// (Upstream used a flat list with numeric .modmask + .description; end4-pC's
+// get_keybinds.py emits string .mods + "Category: desc" .comment.)
+Column {
+    id: root
+    required property string categoryName
+    required property var allBinds
+    readonly property bool isCategorized: categoryName.length > 0
+    property int maxBindWidth: 0
+    property real columnSpacing: 40
+    property real titleSpacing: 7
+
+    // Prettify modifier + key tokens coming from the Lua config.
+    property var keySubstitutions: ({
+        "SUPER": "Super",
+        "SHIFT": "Shift",
+        "CTRL": "Ctrl",
+        "CONTROL": "Ctrl",
+        "ALT": "Alt",
+        "MOD": "Super",
+        "Slash": "/",
+        "Backslash": "\\",
+        "Hash": "#",
+        "Return": "Enter",
+        "Escape": "Esc",
+        "Period": ".",
+        "Comma": ",",
+        "Minus": "-",
+        "Equal": "=",
+        "Space": "Space"
+    })
+
+    property var keyBlacklist: ["SUPER_L", "SUPER_R", "Super_L", "Super_R"]
+
+    function bindCategory(bind) {
+        const c = bind.comment ?? "";
+        const idx = c.indexOf(":");
+        return idx > 0 ? c.substring(0, idx).trim() : "";
+    }
+
+    function transformKey(key) {
+        return root.keySubstitutions[key] ?? key;
+    }
+
+    // Strip the leading "Category: " so the comment column shows only the action.
+    function transformComment(comment) {
+        if (!comment)
+            return "";
+        const idx = comment.indexOf(":");
+        if (idx === -1)
+            return comment;
+        return comment.substring(idx + 1).trim();
+    }
+
+    // Collapse numbered/directional repetitions (e.g. workspace 1..10): keep the
+    // first, drop the rest — the first is shown with a generic placeholder key.
+    function containsNonFirstRepetitive(bind) {
+        const key = String(bind.key ?? "");
+        if (key.includes("mouse") || key.toLowerCase().includes("page"))
+            return false;
+        if (/\d/.test(key) && !key.includes("1"))
+            return true;
+        if (/^(right|up|down)\b/i.test(key))
+            return true;
+        return false;
+    }
+
+    visible: repeater.model.length > 0
+    spacing: titleSpacing
+
+    StyledText {
+        text: root.isCategorized ? root.categoryName : "Uncategorized"
+        font.pixelSize: Appearance.font.pixelSize.title
+    }
+
+    Column {
+        spacing: 4
+        Repeater {
+            id: repeater
+            model: (root.allBinds ?? []).filter(bind => (bind.comment?.length > 0) && (root.bindCategory(bind) === root.categoryName) && !root.containsNonFirstRepetitive(bind))
+            delegate: BindLine {
+                required property var modelData
+                keyData: modelData
+            }
+        }
+    }
+
+    component BindLine: Row {
+        id: bindLine
+        required property var keyData
+        readonly property var mods: bindLine.keyData.mods ?? []
+        readonly property bool keyVisible: !root.keyBlacklist.includes(bindLine.keyData.key)
+
+        Row {
+            spacing: 16
+            Row {
+                id: modRow
+                Component.onCompleted: root.maxBindWidth = Math.max(root.maxBindWidth, implicitWidth)
+                width: root.maxBindWidth
+                spacing: 4
+                Repeater {
+                    model: bindLine.mods
+                    delegate: KeyboardKey {
+                        required property var modelData
+                        key: root.transformKey(modelData)
+                        pixelSize: Appearance.font.pixelSize.smaller
+                    }
+                }
+                StyledText {
+                    anchors.verticalCenter: parent.verticalCenter
+                    visible: bindLine.keyVisible && bindLine.mods.length > 0
+                    text: "+"
+                }
+                KeyboardKey {
+                    anchors.verticalCenter: parent.verticalCenter
+                    visible: bindLine.keyVisible
+                    key: root.transformKey(bindLine.keyData.key)
+                    pixelSize: Appearance.font.pixelSize.smaller
+                }
+            }
+            Item {
+                anchors.verticalCenter: parent.verticalCenter
+                implicitWidth: commentText.implicitWidth + root.columnSpacing
+                implicitHeight: commentText.implicitHeight
+                StyledText {
+                    id: commentText
+                    anchors.verticalCenter: parent.verticalCenter
+                    anchors.left: parent.left
+                    font.pixelSize: Appearance.font.pixelSize.smaller
+                    text: root.transformComment(bindLine.keyData.comment)
+                }
+            }
+        }
+    }
+}
diff --git a/modules/ii/cheatsheet/CheatsheetPeriodicTable.qml b/modules/ii/cheatsheet/CheatsheetPeriodicTable.qml
new file mode 100644
index 0000000..6262ed7
--- /dev/null
+++ b/modules/ii/cheatsheet/CheatsheetPeriodicTable.qml
@@ -0,0 +1,63 @@
+import "periodic_table.js" as PTable
+import QtQuick
+
+Item {
+    id: root
+    readonly property var elements: PTable.elements
+    readonly property var series: PTable.series
+    property real spacing: 6
+    implicitWidth: mainLayout.implicitWidth
+    implicitHeight: mainLayout.implicitHeight
+
+    Column {
+        id: mainLayout
+        anchors.centerIn: parent
+        spacing: root.spacing
+
+        Repeater { // Main table rows
+            model: root.elements
+            
+            delegate: Row { // Table cells
+                id: tableRow
+                spacing: root.spacing
+                required property var modelData
+                
+                Repeater {
+                    model: tableRow.modelData
+                    delegate: ElementTile {
+                        required property var modelData
+                        element: modelData
+                    }
+
+                }
+            }
+            
+        }
+
+        Item {
+            id: gap
+            implicitHeight: 20
+        }
+
+        Repeater { // Main table rows
+            model: root.series
+            
+            delegate: Row { // Table cells
+                id: seriesTableRow
+                spacing: root.spacing
+                required property var modelData
+                
+                Repeater {
+                    model: seriesTableRow.modelData
+                    delegate: ElementTile {
+                        required property var modelData
+                        element: modelData
+                    }
+
+                }
+            }
+            
+        }
+    }
+    
+}
\ No newline at end of file
