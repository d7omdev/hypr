+def split_first_arg(rest: str):
+    """Return the text of the first hl.bind argument (up to the top-level comma),
+    string- and bracket-aware, so concatenated key expressions survive intact."""
+    depth = 0
+    in_str = None  # '"' or ']]' (long-bracket string)
+    i, n = 0, len(rest)
+    while i < n:
+        two = rest[i:i + 2]
+        if in_str is None:
+            if two == "[[":
+                in_str = "]]"; i += 2; continue
+            c = rest[i]
+            if c == '"':
+                in_str = '"'; i += 1; continue
+            if c in "([{":
+                depth += 1
+            elif c in ")]}":
+                if depth == 0:
+                    break
+                depth -= 1
+            elif c == "," and depth == 0:
+                return rest[:i]
+            i += 1
+        elif in_str == '"':
+            if rest[i] == '"':
+                in_str = None
+            i += 1
+        else:  # ]]
+            if two == "]]":
+                in_str = None; i += 2; continue
+            i += 1
+    return rest[:i]
+
